# ParseIQ Web — frontend environment variables
# Copy this file to `.env.local` and fill in the values you want.
# `.env.local` is gitignored by default in Vite projects.

# ─── Analytics (both optional) ─────────────────────────────────────────────
# Microsoft Clarity — free, unlimited, gives heatmaps + session replays + metrics
# Sign up: https://clarity.microsoft.com → create project → copy the Project ID
VITE_CLARITY_ID=

# Google Analytics 4 — free, good for aggregate user/session/time-on-site numbers
# Sign up: https://analytics.google.com → create GA4 property → copy Measurement ID
VITE_GA_ID=

# ─── Buy Me a Coffee button (optional) ─────────────────────────────────────
# Your buymeacoffee.com handle. Leave empty to hide the floating button.
# Sign up: https://www.buymeacoffee.com/
VITE_BMC_USERNAME=
