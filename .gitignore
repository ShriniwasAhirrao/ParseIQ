# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.env

# Pytest
.pytest_cache/

# Generated at runtime — do not commit
debug_output/*
logs/*
output/*.csv
output/*.xlsx
output/*.json

# Keep directory structure
!debug_output/.gitkeep
!logs/.gitkeep
!output/.gitkeep

# Large generated test files
input/stress_test_data.json

# Coverage reports
.coverage
coverage.xml

# Build artifacts
build/
*.egg-info/
dist/

# Test artefacts
input/test_sample.csv
output/csv_test/
output/wheel_test/

# Test virtual envs
.test_venv/

.claude/

# Node.js
node_modules/

# Web UI build
web/frontend/dist/

# Runtime logs and output (already covered above but explicit)
logs/
output/
